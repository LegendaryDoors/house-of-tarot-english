 {
  "id": 762,
  "context": "Title screen marquee",
  "jp": "『タロットうらない』とは?  このソフトでは『大アルカナ』とよばれている22まいのカードでうらないをします。『うらない』をするときには、心をしずめて『しゅうちゅう』してうらないましょう。おなじ『しつもん』をつづけてうらなうと『こうか』がなくなるといわれていますのできをつけましょう。",
  "en": "What is tarot reading? This program tells your fortune with the 22 cards known as the Major Arcana. When you have your fortune read, calm your mind and concentrate. It is said that asking the same question again and again makes the reading lose its power, so take care."
 },
 {
  "id": 763,
  "context": "Intro marquee (the house)",
  "jp": "あるひ、あなたはみなれた『けしき』がちがうコトにきがつきます。  『あれ? あんなところにおゥチがたってるわ。  へんネ、まえには なかったのに・・・  タロットのやかた?  だれでもうらなってもらえるのかしら・・・』",
  "en": "One day, you notice that the familiar scenery looks different. \"Huh? There's a house standing over there. That's odd, it wasn't there before... The House of Tarot? I wonder if anyone can have their fortune told there...\""
 },
 {
  "id": 764,
  "context": "Intro marquee (the door)",
  "jp": "とびらはすこしあいているようです。『あなたのくるのを おまちしていました。どうぞ、おはいりください。』  『どうしてわたしがくるのがわかったのかしら・・・』  さあ、とびらをあけてみましょう。",
  "en": "The door seems to be slightly open. \"We have been waiting for you to come. Please, come in.\" \"How did they know I was coming...?\" Now, let's open the door."
 },
 {
  "id": 765,
  "context": "Fortune teller names under the portraits",
  "jp": "ナナ レジナ ルド",
  "en": "Nana Regina Rudo"
 },
 {
  "id": 766,
  "context": "Fortune teller selection",
  "jp": "だれにうらなって\nもらうか、ちょっと\nのぞいてみましょう。",
  "en": "Let's take a peek at who might read your fortune."
 },
 {
  "id": 767,
  "context": "Nana's greeting",
  "jp": "あなたの『こい』の\nなやみにこたえるわ。",
  "en": "I'll answer your worries about love."
 },
 {
  "id": 768,
  "context": "Regina's greeting",
  "jp": "せいせきやおしごとのなやみにこたえます。",
  "en": "I will answer your worries about grades and work."
 },
 {
  "id": 769,
  "context": "Rudo's greeting (good mood)",
  "jp": "きょうはきぶんがよい。ワシに、まかせなさい。",
  "en": "I am in a good mood today. Leave it to me."
 },
 {
  "id": 770,
  "context": "Rudo's greeting (refusal)",
  "jp": "きょうは、ほかの人にたのんでくれんかのー。",
  "en": "Not today. Ask one of the others, would you?"
 },
 {
  "id": 771,
  "context": "Rudo's second refusal",
  "jp": "ワシは、きょうはつかれとるんじゃがのぉー。",
  "en": "I am worn out today, mind you..."
 },
 {
  "id": 772,
  "context": "Confirm prompt",
  "jp": "1 やめる／2 きめる",
  "en": "1 Back / 2 Choose"
 },
 {
  "id": 773,
  "context": "Nana and Regina: before the reading",
  "jp": "わたしがうらないます。では、あなたのことをすこし、おしえてね。",
  "en": "I will be reading for you. Tell me a little about yourself."
 },
 {
  "id": 774,
  "context": "Rudo: before the reading",
  "jp": "では、はじめよう。\nおまえさまのことを\nすこし、きこうかのう。",
  "en": "Let us begin, then. First, tell me a little about yourself, young one."
 },
 {
  "id": 775,
  "context": "Rudo: after refusing",
  "jp": "では、しかたがない。まったく、わがままなヤツじゃのう。",
  "en": "Well, it cannot be helped. Hmph. What a selfish one."
 },
